!
!
!  Locally symmetrized (decoupled) aggregation algorithm.
!  This version differs from the basic decoupled aggregation algorithm
!  only because it works on (the pattern of)  A+A^T  instead of A. 
!
!    
module amg_@X@_symdec_aggregator_mod

  use amg_@X@_dec_aggregator_mod
  !> \namespace  amg_@X@_symdec_aggregator_mod  \class  amg_@X@_symdec_aggregator_type
  !! \extends amg_@X@_dec_aggregator_mod::amg_@X@_dec_aggregator_type
  !!
  !!  This version differs from the basic decoupled aggregation algorithm
  !!   only because it works on (the pattern of)  A+A^T  instead of A.
  !!   
  !
  type, extends(amg_@X@_dec_aggregator_type) :: amg_@X@_symdec_aggregator_type
    
  contains
    procedure, pass(ag) :: bld_tprol    => amg_@X@_symdec_aggregator_build_tprol
    procedure, pass(ag) :: descr        => amg_@X@_symdec_aggregator_descr
    procedure, nopass   :: fmt          => amg_@X@_symdec_aggregator_fmt
  end type amg_@X@_symdec_aggregator_type


  interface
    subroutine  amg_@X@_symdec_aggregator_build_tprol(ag,parms,ag_data,&
         & a,desc_a,ilaggr,nlaggr,t_prol,info)
      import :: amg_@X@_symdec_aggregator_type, psb_desc_type, psb_@X@spmat_type, @FKIND@,  &
           & psb_ipk_, psb_lpk_,  psb_@LX@spmat_type, amg_@RT@ml_parms, amg_@RT@aggr_data
      implicit none
      class(amg_@X@_symdec_aggregator_type), target, intent(inout) :: ag
      type(amg_@RT@ml_parms), intent(inout)  :: parms 
      type(amg_@RT@aggr_data), intent(in)    :: ag_data
      type(psb_@X@spmat_type), intent(inout) :: a
      type(psb_desc_type), intent(inout)     :: desc_a
      integer(psb_lpk_), allocatable, intent(out) :: ilaggr(:),nlaggr(:)
      type(psb_@LX@spmat_type), intent(out)  :: t_prol
      integer(psb_ipk_), intent(out)      :: info
    end subroutine amg_@X@_symdec_aggregator_build_tprol
  end interface


contains

  function amg_@X@_symdec_aggregator_fmt() result(val)
    implicit none 
    character(len=32)  :: val

    val = "Symmetric Decoupled aggregation"
  end function amg_@X@_symdec_aggregator_fmt
  
  subroutine  amg_@X@_symdec_aggregator_descr(ag,parms,iout,info,prefix)
    implicit none 
    class(amg_@X@_symdec_aggregator_type), intent(in) :: ag
    type(amg_@RT@ml_parms), intent(in)   :: parms
    integer(psb_ipk_), intent(in)  :: iout
    integer(psb_ipk_), intent(out) :: info
    character(len=*), intent(in), optional  :: prefix

    character(1024)    :: prefix_
    info = psb_success_
    if (present(prefix)) then
      prefix_ = prefix
    else
      prefix_ = ""
    end if

    write(iout,*) trim(prefix_),' ','Decoupled Aggregator locally-symmetrized'
    write(iout,*) trim(prefix_),' ','Aggregator object type: ',ag%fmt()
    call parms%mldescr(iout,info,prefix=prefix)
    
    return
  end subroutine amg_@X@_symdec_aggregator_descr

end module amg_@X@_symdec_aggregator_mod

!
! File: amg_@X@_umf_solver_mod.f90
!
! Module: amg_@X@_umf_solver_mod
!
!  This module defines: 
!  - the amg_@X@_umf_solver_type data structure containing the ingredients
!    to interface with the UMFPACK package. 
!    1. The factorization is restricted to the diagonal block of the
!       current image.
!
module amg_@X@_umf_solver

  use iso_c_binding
  use amg_@X@_base_solver_mod

#if defined(PSB_IPK8)
  type, extends(amg_@X@_base_solver_type) :: amg_@X@_umf_solver_type

  end type amg_@X@_umf_solver_type

#else
  
  type, extends(amg_@X@_base_solver_type) :: amg_@X@_umf_solver_type
    type(c_ptr)                 :: symbolic=c_null_ptr, numeric=c_null_ptr
    integer(c_long_long)        :: symbsize=0, numsize=0
  contains
    procedure, pass(sv) :: build   => amg_@X@_umf_solver_bld
    procedure, pass(sv) :: apply_a => amg_@X@_umf_solver_apply
    procedure, pass(sv) :: apply_v => amg_@X@_umf_solver_apply_vect
    procedure, pass(sv) :: free    => @X@_umf_solver_free
    procedure, pass(sv) :: clear_data  => @X@_umf_solver_clear_data
    procedure, pass(sv) :: descr   => @X@_umf_solver_descr
    procedure, pass(sv) :: sizeof  => @X@_umf_solver_sizeof
    procedure, nopass   :: get_fmt => @X@_umf_solver_get_fmt
    procedure, nopass   :: get_id  => @X@_umf_solver_get_id
    final               :: @X@_umf_solver_finalize
  end type amg_@X@_umf_solver_type


  private :: @X@_umf_solver_free,   @X@_umf_solver_descr, &
       &  @X@_umf_solver_sizeof, &
       &  @X@_umf_solver_get_fmt, @X@_umf_solver_get_id, &
       &  @X@_umf_solver_clear_data
  private :: @X@_umf_solver_finalize



  interface 
    function amg_@X@umf_fact(n,nnz,values,rowind,colptr,&
         & symptr,numptr,ssize,nsize)&
         & bind(c,name='amg_@X@umf_fact') result(info)
      use iso_c_binding
      integer(c_int), value :: n,nnz
      integer(c_int)        :: info
      integer(c_long_long)  :: ssize, nsize
      integer(c_int)        :: rowind(*),colptr(*)
      @TYPE@(@FCKIND@)  :: values(*)
      type(c_ptr)           :: symptr, numptr
    end function amg_@X@umf_fact
  end interface

  interface 
    function amg_@X@umf_solve(itrans,n,x, b, ldb, numptr)&
         & bind(c,name='amg_@X@umf_solve') result(info)
      use iso_c_binding
      integer(c_int)        :: info
      integer(c_int), value :: itrans,n,ldb
      @TYPE@(@FCKIND@) :: x(*), b(ldb,*)
      type(c_ptr), value    :: numptr
    end function amg_@X@umf_solve
  end interface

  interface 
    function amg_@X@umf_free(symptr, numptr)&
         & bind(c,name='amg_@X@umf_free') result(info)
      use iso_c_binding
      integer(c_int)        :: info
      type(c_ptr), value    :: symptr, numptr
    end function amg_@X@umf_free
  end interface

  interface
    subroutine amg_@X@_umf_solver_apply(alpha,sv,x,beta,y,desc_data,&
         & trans,work,info,init,initu)
      use psb_base_mod
      import amg_@X@_umf_solver_type
      implicit none 
      type(psb_desc_type), intent(in)      :: desc_data
      class(amg_@X@_umf_solver_type), intent(inout) :: sv
      @TYPE@(@FKIND@),intent(inout)         :: x(:)
      @TYPE@(@FKIND@),intent(inout)         :: y(:)
      @TYPE@(@FKIND@),intent(in)            :: alpha,beta
      character(len=1),intent(in)          :: trans
      @TYPE@(@FKIND@),target, intent(inout) :: work(:)
      integer(psb_ipk_), intent(out)        :: info
      character, intent(in), optional       :: init
      @TYPE@(@FKIND@),intent(inout), optional :: initu(:)
    end subroutine amg_@X@_umf_solver_apply
  end interface
  
  interface
    subroutine amg_@X@_umf_solver_apply_vect(alpha,sv,x,beta,y,desc_data,&
         & trans,work,wv,info,init,initu)
      use psb_base_mod
      import amg_@X@_umf_solver_type
      implicit none 
      type(psb_desc_type), intent(in)      :: desc_data
      class(amg_@X@_umf_solver_type), intent(inout) :: sv
      type(psb_@X@_vect_type),intent(inout)  :: x
      type(psb_@X@_vect_type),intent(inout)  :: y
      @TYPE@(@FKIND@),intent(in)            :: alpha,beta
      character(len=1),intent(in)           :: trans
      @TYPE@(@FKIND@),target, intent(inout) :: work(:)
      type(psb_@X@_vect_type),intent(inout) :: wv(:)
      integer(psb_ipk_), intent(out)                 :: info
      character, intent(in), optional                :: init
      type(psb_@X@_vect_type),intent(inout), optional   :: initu
    end subroutine amg_@X@_umf_solver_apply_vect
  end interface

  interface 
    subroutine amg_@X@_umf_solver_bld(a,desc_a,sv,info,b,amold,vmold,imold)
      use psb_base_mod
      import amg_@X@_umf_solver_type
      Implicit None
      
      ! Arguments
      type(psb_@X@spmat_type), intent(in), target           :: a
      Type(psb_desc_type), Intent(inout)                  :: desc_a 
      class(amg_@X@_umf_solver_type), intent(inout)         :: sv
      integer(psb_ipk_), intent(out)                        :: info
      type(psb_@X@spmat_type), intent(in), target, optional :: b
      class(psb_@X@_base_sparse_mat), intent(in), optional  :: amold
      class(psb_@X@_base_vect_type), intent(in), optional   :: vmold
      class(psb_i_base_vect_type), intent(in), optional  :: imold
    end subroutine amg_@X@_umf_solver_bld
  end interface

contains


  subroutine @X@_umf_solver_free(sv,info)

    Implicit None

    ! Arguments
    class(amg_@X@_umf_solver_type), intent(inout) :: sv
    integer, intent(out)                       :: info
    Integer :: err_act
    character(len=20)  :: name='@X@_umf_solver_free'

    call psb_erractionsave(err_act)

    call sv%clear_data(info) 
    
    if (info /= psb_success_) goto 9999

    call psb_erractionrestore(err_act)
    return

9999 call psb_error_handler(err_act)
    return
  end subroutine @X@_umf_solver_free


  subroutine @X@_umf_solver_clear_data(sv,info)

    Implicit None

    ! Arguments
    class(amg_@X@_umf_solver_type), intent(inout) :: sv
    integer, intent(out)                       :: info
    Integer :: err_act
    character(len=20)  :: name='@X@_umf_solver_clear_data'

    call psb_erractionsave(err_act)
    info = 0 
    if (c_associated(sv%symbolic).and.c_associated(sv%numeric)) then 
      info = amg_@X@umf_free(sv%symbolic,sv%numeric)
      
      if (info /= psb_success_) goto 9999
      sv%symbolic = c_null_ptr
      sv%numeric  = c_null_ptr
      sv%symbsize = 0
      sv%numsize  = 0
    end if

    call psb_erractionrestore(err_act)
    return

9999 call psb_error_handler(err_act)
    return
  end subroutine @X@_umf_solver_clear_data

  subroutine @X@_umf_solver_finalize(sv)

    Implicit None

    ! Arguments
    type(amg_@X@_umf_solver_type), intent(inout) :: sv
    integer :: info
    Integer :: err_act
    character(len=20)  :: name='@X@_umf_solver_finalize'

    call sv%free(info) 

    return
  
  end subroutine @X@_umf_solver_finalize

  subroutine @X@_umf_solver_descr(sv,info,iout,coarse,prefix)

    Implicit None

    ! Arguments
    class(amg_@X@_umf_solver_type), intent(in) :: sv
    integer, intent(out)                       :: info
    integer, intent(in), optional              :: iout
    logical, intent(in), optional              :: coarse
      character(len=*), intent(in), optional   :: prefix

    ! Local variables
    integer      :: err_act
    character(len=20), parameter :: name='amg_@X@_umf_solver_descr'
    integer :: iout_
    character(1024)    :: prefix_

    call psb_erractionsave(err_act)
    info = psb_success_
    if (present(iout)) then 
      iout_ = iout 
    else
      iout_ = psb_out_unit
    endif
    if (present(prefix)) then
      prefix_ = prefix
    else
      prefix_ = ""
    end if
    
    write(iout_,*) trim(prefix_), '  UMFPACK Sparse Factorization Solver. '

    call psb_erractionrestore(err_act)
    return

9999 call psb_error_handler(err_act)
    return
  end subroutine @X@_umf_solver_descr

  function @X@_umf_solver_sizeof(sv) result(val)

    implicit none 
    ! Arguments
    class(amg_@X@_umf_solver_type), intent(in) :: sv
    integer(psb_epk_) :: val
    integer             :: i

    val = 2*psb_sizeof_lp 
    val = val + sv%symbsize
    val = val + sv%numsize
    return
  end function @X@_umf_solver_sizeof

  function @X@_umf_solver_get_fmt() result(val)
    implicit none 
    character(len=32)  :: val

    val = "UMFPACK solver"
  end function @X@_umf_solver_get_fmt

  function @X@_umf_solver_get_id() result(val)
    implicit none 
    integer(psb_ipk_)  :: val

    val = amg_umf_
  end function @X@_umf_solver_get_id
#endif
end module amg_@X@_umf_solver

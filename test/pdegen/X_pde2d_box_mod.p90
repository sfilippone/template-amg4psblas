module amg_@X@_pde2d_box_mod
  use psb_base_mod, only : @FKIND@, @RZERO@, @RONE@
  @RTYPE@(@FKIND@), save, private :: epsilon=@RONE@/80
contains
  subroutine pde_set_parm(dat)
    @RTYPE@(@FKIND@), intent(in) :: dat
    epsilon = dat
  end subroutine pde_set_parm
  !
  ! functions parametrizing the differential equation
  !
  function b1_box(x,y)
    use psb_base_mod, only : @FKIND@, @RZERO@, @RONE@
    @RTYPE@(@FKIND@) :: b1_box
    @RTYPE@(@FKIND@), intent(in) :: x,y
    b1_box = @RONE@/1.414_@FKIND@
  end function b1_box
  function b2_box(x,y)
    use psb_base_mod, only : @FKIND@, @RZERO@, @RONE@
    @RTYPE@(@FKIND@) ::  b2_box
    @RTYPE@(@FKIND@), intent(in) :: x,y
    b2_box = @RONE@/1.414_@FKIND@
  end function b2_box
  function c_box(x,y)
    use psb_base_mod, only : @FKIND@, @RZERO@, @RONE@
    @RTYPE@(@FKIND@) ::  c_box
    @RTYPE@(@FKIND@), intent(in) :: x,y
    c_box = @RZERO@
  end function c_box
  function a1_box(x,y)
    use psb_base_mod, only : @FKIND@, @RZERO@, @RONE@
    @RTYPE@(@FKIND@) ::  a1_box
    @RTYPE@(@FKIND@), intent(in) :: x,y
    a1_box=@RONE@*epsilon
  end function a1_box
  function a2_box(x,y)
    use psb_base_mod, only : @FKIND@, @RZERO@, @RONE@
    @RTYPE@(@FKIND@) ::  a2_box
    @RTYPE@(@FKIND@), intent(in) :: x,y
    a2_box=@RONE@*epsilon
  end function a2_box
  function g_box(x,y)
    use psb_base_mod, only : @FKIND@, @RZERO@, @RONE@
    @RTYPE@(@FKIND@) ::  g_box
    @RTYPE@(@FKIND@), intent(in) :: x,y
    g_box = @RZERO@
    if (x == @RONE@) then
      g_box = @RONE@
    else if (x == @RZERO@) then
      g_box = @RONE@
    end if
  end function g_box
end module amg_@X@_pde2d_box_mod

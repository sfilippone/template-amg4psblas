module amg_@X@_pde2d_exp_mod
  use psb_base_mod, only : @FKIND@, @RONE@, @RZERO@
  @RTYPE@(@FKIND@), save, private :: epsilon=@RONE@/80
contains
  subroutine pde_set_parm(dat)
    @RTYPE@(@FKIND@), intent(in) :: dat
    epsilon = dat
  end subroutine pde_set_parm
  !
  ! functions parametrizing the differential equation
  !
  function b1_exp(x,y)
    use psb_base_mod, only : @FKIND@, @RONE@, @RZERO@
    @RTYPE@(@FKIND@) :: b1_exp
    @RTYPE@(@FKIND@), intent(in) :: x,y
    b1_exp = @RZERO@
  end function b1_exp
  function b2_exp(x,y)
    use psb_base_mod, only : @FKIND@, @RONE@, @RZERO@
    @RTYPE@(@FKIND@) ::  b2_exp
    @RTYPE@(@FKIND@), intent(in) :: x,y
    b2_exp = @RZERO@
  end function b2_exp
  function c_exp(x,y)
    use psb_base_mod, only : @FKIND@, @RONE@, @RZERO@
    @RTYPE@(@FKIND@) ::  c_exp
    @RTYPE@(@FKIND@), intent(in) :: x,y
    c_exp = @RZERO@
  end function c_exp
  function a1_exp(x,y)
    use psb_base_mod, only : @FKIND@, @RONE@, @RZERO@
    @RTYPE@(@FKIND@) ::  a1_exp
    @RTYPE@(@FKIND@), intent(in) :: x,y
    a1=@RONE@*epsilon*exp(-(x+y))
  end function a1_exp
  function a2_exp(x,y)
    use psb_base_mod, only : @FKIND@, @RONE@, @RZERO@
    @RTYPE@(@FKIND@) ::  a2_exp
    @RTYPE@(@FKIND@), intent(in) :: x,y
    a2=@RONE@*epsilon*exp(-(x+y))
  end function a2_exp
  function g_exp(x,y)
    use psb_base_mod, only : @FKIND@, @RONE@, @RZERO@
    @RTYPE@(@FKIND@) ::  g_exp
    @RTYPE@(@FKIND@), intent(in) :: x,y
    g_exp = @RZERO@
    if (x == @RONE@) then
      g_exp = @RONE@
    else if (x == @RZERO@) then
      g_exp = @RONE@
    end if
  end function g_exp
end module amg_@X@_pde2d_exp_mod

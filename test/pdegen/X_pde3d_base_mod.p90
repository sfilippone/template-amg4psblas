module amg_@X@_pde3d_base_mod
  use psb_base_mod, only : @FKIND@, @RONE@
  @RTYPE@(@FKIND@), save, private :: epsilon=@RONE@/80
contains
  subroutine pde_set_parm(dat)
    @RTYPE@(@FKIND@), intent(in) :: dat
    epsilon = dat
  end subroutine pde_set_parm
  !
  ! functions parametrizing the differential equation
  !
  function b1(x,y,z)
    use psb_base_mod, only : @FKIND@, @RONE@
    @RTYPE@(@FKIND@) :: b1
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    b1=@RONE@/sqrt(3.0_@FKIND@)
  end function b1
  function b2(x,y,z)
    use psb_base_mod, only : @FKIND@, @RONE@
    @RTYPE@(@FKIND@) ::  b2
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    b2=@RONE@/sqrt(3.0_@FKIND@)
  end function b2
  function b3(x,y,z)
    use psb_base_mod, only : @FKIND@, @RONE@
    @RTYPE@(@FKIND@) ::  b3
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    b3=@RONE@/sqrt(3.0_@FKIND@)
  end function b3
  function c(x,y,z)
    use psb_base_mod, only : @FKIND@, @RONE@
    @RTYPE@(@FKIND@) ::  c
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    c=@RZERO@
  end function c
  function a1(x,y,z)
    use psb_base_mod, only : @FKIND@
    @RTYPE@(@FKIND@) ::  a1
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    a1=epsilon
  end function a1
  function a2(x,y,z)
    use psb_base_mod, only : @FKIND@
    @RTYPE@(@FKIND@) ::  a2
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    a2=epsilon
  end function a2
  function a3(x,y,z)
    use psb_base_mod, only : @FKIND@
    @RTYPE@(@FKIND@) ::  a3
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    a3=epsilon
  end function a3
  function g(x,y,z)
    use psb_base_mod, only : @FKIND@, @RONE@, @RZERO@
    @RTYPE@(@FKIND@) ::  g
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    g = @RZERO@
    if (x == @RONE@) then
      g = @RONE@
    else if (x == @RZERO@) then
      g = @RONE@
    end if
  end function g
end module amg_@X@_pde3d_base_mod

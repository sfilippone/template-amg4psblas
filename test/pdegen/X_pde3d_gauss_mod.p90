module amg_@X@_pde3d_gauss_mod
  use psb_base_mod, only : @FKIND@, @RONE@
  @RTYPE@(@FKIND@), save, private :: epsilon=@RONE@/80
contains
  subroutine pde_set_parm(dat)
    @RTYPE@(@FKIND@), intent(in) :: dat
    epsilon = dat
  end subroutine pde_set_parm
  !
  ! functions parametrizing the differential equation
  !
  function b1_gauss(x,y,z)
    use psb_base_mod, only : @FKIND@, @RONE@
    @RTYPE@(@FKIND@) :: b1_gauss
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    b1_gauss=@RONE@/sqrt(3.0_@FKIND@)-2*x*exp(-(x**2+y**2+z**2))
  end function b1_gauss
  function b2_gauss(x,y,z)
    use psb_base_mod, only : @FKIND@, @RONE@
    @RTYPE@(@FKIND@) ::  b2_gauss
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    b2_gauss=@RONE@/sqrt(3.0_@FKIND@)-2*y*exp(-(x**2+y**2+z**2))
  end function b2_gauss
  function b3_gauss(x,y,z)
    use psb_base_mod, only : @FKIND@, @RONE@
    @RTYPE@(@FKIND@) ::  b3_gauss
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    b3_gauss=@RONE@/sqrt(3.0_@FKIND@)-2*z*exp(-(x**2+y**2+z**2))
  end function b3_gauss
  function c_gauss(x,y,z)
    use psb_base_mod, only : @FKIND@, @RZERO@
    @RTYPE@(@FKIND@) ::  c_gauss
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    c=@RZERO@
  end function c_gauss
  function a1_gauss(x,y,z)
    use psb_base_mod, only : @FKIND@
    @RTYPE@(@FKIND@) ::  a1_gauss
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    a1_gauss=epsilon*exp(-(x**2+y**2+z**2))
  end function a1_gauss
  function a2_gauss(x,y,z)
    use psb_base_mod, only : @FKIND@
    @RTYPE@(@FKIND@) ::  a2_gauss
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    a2_gauss=epsilon*exp(-(x**2+y**2+z**2))
  end function a2_gauss
  function a3_gauss(x,y,z)
    use psb_base_mod, only : @FKIND@
    @RTYPE@(@FKIND@) ::  a3_gauss
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    a3_gauss=epsilon*exp(-(x**2+y**2+z**2))
  end function a3_gauss
  function g_gauss(x,y,z)
    use psb_base_mod, only : @FKIND@, @RONE@, @RZERO@
    @RTYPE@(@FKIND@) ::  g_gauss
    @RTYPE@(@FKIND@), intent(in) :: x,y,z
    g_gauss = @RZERO@
    if (x == @RONE@) then
      g_gauss = @RONE@
    else if (x == @RZERO@) then
      g_gauss = @RONE@
    end if
  end function g_gauss
end module amg_@X@_pde3d_gauss_mod
